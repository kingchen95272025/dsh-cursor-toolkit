{
	"name": "dsh-cursor-toolkit",
	"version": "2.2.0",
	"description": "Brings Cursor rules, skills and MCP servers (.cursor) into DeepSeek Harness: ships the Cursor agent preset, injects .mdc rules and a skill catalog into the agent context, exposes a cursor_skill tool, and connects .cursor/mcp.json servers on demand.",
	"type": "module",
	"main": "lib/index.js",
	"exports": {
		".": "./lib/index.js",
		"./client": "./lib/client.js",
		"./locale/*.json": "./locale/*.json",
		"./icon": "./icon.svg",
		"./package.json": "./package.json"
	},
	"icon": "icon.svg",
	"files": [
		"lib/index.js",
		"lib/rules.js",
		"lib/client.js",
		"cordis.patch.yml",
		"presets/*.patch.yml",
		"locale/*.json",
		"icon.svg",
		"assets/icon-180.png",
		"README*.md",
		"LICENSE"
	],
	"dsh": {
		"bundle": {
			"patch": [
				"./cordis.patch.yml",
				"./presets/cursor.patch.yml"
			]
		},
		"client": {
			"platform": "web"
		}
	},
	"engines": {
		"node": "^22.19.0 || >=24.0.0",
		"dsh": ">=0.2.0-rc.2 || >=0.2.1-rc.2 || >=0.2.2-rc.1"
	},
	"peerDependencies": {
		"@deepseek-ai/dsh-home-paths": ">=0.2.0-rc.2 || >=0.2.1-rc.2 || >=0.2.2-rc.1",
		"@deepseek-ai/dsh-llm": ">=0.2.0-rc.2 || >=0.2.1-rc.2 || >=0.2.2-rc.1",
		"@deepseek-ai/dsh-client-ui-primitives": ">=0.2.0-rc.2 || >=0.2.1-rc.2 || >=0.2.2-rc.1",
		"@deepseek-ai/schemastery": "^3.18.2 || >=3.18.6-alpha.2 <4.0.0",
		"react": "^18.3.1",
		"@deepseek-ai/dsh-tools": ">=0.2.0-rc.2 || >=0.2.1-rc.2 || >=0.2.2-rc.1",
		"@deepseek-ai/dsh-mcp-client": ">=0.2.0-rc.2 || >=0.2.1-rc.2 || >=0.2.2-rc.1"
	},
	"peerDependenciesMeta": {
		"@deepseek-ai/dsh-client-ui-primitives": {
			"optional": true
		},
		"react": {
			"optional": true
		},
		"@deepseek-ai/dsh-mcp-client": {
			"optional": true
		}
	},
	"scripts": {
		"test": "node test/smoke.mjs && node test/host.mjs && node test/preset.mjs && node test/client.mjs",
		"test:host": "node test/host.mjs",
		"test:rules": "node test/smoke.mjs",
		"test:client": "node test/client.mjs",
		"test:preset": "node test/preset.mjs"
	},
	"keywords": [
		"dsh",
		"dsh-plugin",
		"dsh-bundle",
		"cursor",
		"cursor-rules",
		"cursor-skills",
		"mcp",
		"mdc",
		"rules",
		"skills",
		"context"
	],
	"author": "kingchen95272025",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kingchen95272025/dsh-cursor-toolkit.git"
	},
	"homepage": "https://github.com/kingchen95272025/dsh-cursor-toolkit#readme",
	"bugs": {
		"url": "https://github.com/kingchen95272025/dsh-cursor-toolkit/issues"
	}
}
